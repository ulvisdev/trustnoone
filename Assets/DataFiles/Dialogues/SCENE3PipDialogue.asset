    choices: []
    askForPlayerName: 0
  - speaker: 1
    text: '[shake]AHH! Eh![/shake] [wave=0.35]I mean[/wave], pleased to meet you!
      I [wave=0.25]humbly[/wave] apologize for my reaction! It was [wave=0.25]most[/wave]
      improper, and-'
    nextNodeIndex: -1
    endDialogue: 0
    autoProgress: 0
    autoProgressDelay: 0
    requiredFlag: 
    forbiddenFlag: 
    flagToSet: 
    choices: []
    askForPlayerName: 0
  - speaker: 0
    text: Hahaha! [wave=0.35]Chill out, bro![/wave] Happens to [wave=0.2]every[/wave]
      newcomer. You'll get used to [item]new faces[/item].
    nextNodeIndex: -1
    endDialogue: 0
    autoProgress: 0
    autoProgressDelay: 0
    requiredFlag: 
    forbiddenFlag: 
    flagToSet: 
    choices: []
    askForPlayerName: 0
  - speaker: 1
    text: Chill out? Bro??
    nextNodeIndex: -1
    endDialogue: 0
    autoProgress: 1
    autoProgressDelay: 2
    requiredFlag: 
    forbiddenFlag: 
    flagToSet: 
    choices: []
    askForPlayerName: 0
  - speaker: 0
    text: '[wave=0.35]Yeah![/wave] Sir [wave=0.15][item]Vohnung[/wave][/item] informed
      me of your arrival, so I made sure to [wave=0.2]brush up[/wave] on [item]human
      customs[/item], to make sure you feel welcome! The name''s [item]Pip Squeak[/item],
      by the way. What''s your name?'
    nextNodeIndex: -1
    endDialogue: 0
    autoProgress: 0
    autoProgressDelay: 0
    requiredFlag: 
    forbiddenFlag: 
    flagToSet: 
    choices: []
    askForPlayerName: 1
  - speaker: 1
    text: (That'll be easy to remember.) I'm [item]{playerName}[/item].
    nextNodeIndex: -1
    endDialogue: 0
    autoProgress: 0
    autoProgressDelay: 0
    requiredFlag: 
    forbiddenFlag: 
    flagToSet: 
    choices: []
    askForPlayerName: 0
  - speaker: 0
    text: Ok, [item][wave=0.2]{playerName}[/wave][/item]. [wave=0.35]Follow me[/wave],
      I shall take you to the [item]dining hall[/item], but make sure you [wave=0.2][shake=0.2]dont[/shake]
      lose your cool[/wave] this time hehehe.
    nextNodeIndex: -1
