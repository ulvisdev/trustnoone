  nodes:
  - speaker: 0
    text: '[wave=0.35][item]Greetings![/item][/wave] Welcome to sir [item][wave=0.25]Vohnungs[/item][/wave]
      estate! I am his assis-'
    nextNodeIndex: -1
    endDialogue: 0
    autoProgress: 1
    autoProgressDelay: 2
    requiredFlag: 
    forbiddenFlag: 
